.installed.cfg
*.egg

# Virtual environments
.venv/
.venv311/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
/data/*.db

# Node / Frontend
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# IDEs & System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and scratch
*.log
scratch/

