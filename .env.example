# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and populate with your actual API keys.
# REAL KEYS MUST NEVER BE COMMITTED TO THE REPOSITORY.
# ==============================================================================

# Comma-separated LLM key pool (at least 2 keys required for failover demonstration).
# Key IDs will be assigned sequentially as key_1, key_2, ...
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# Target LLM Model (e.g. Google Gemini 3.5 Flash)
LLM_MODEL=gemini/gemini-3.5-flash

# SQLite Database Location (survives container restarts when mounted to /data volume)
DATABASE_URL=sqlite:///./data/app.db

# Permitted CORS Origins (comma-separated list for local development and deployed frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure header hook for on-demand failover evaluation
ENABLE_FAILURE_SIMULATION=true

# Server Host & Port
HOST=0.0.0.0
PORT=8000

